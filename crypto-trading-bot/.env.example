# ============================================================================
# Variables de entorno. Copia a .env y rellena.
#     cp .env.example .env
#
# .env está en .gitignore y NUNCA debe subirse al repositorio.
# ============================================================================

# --- Exchange ---------------------------------------------------------------
# IMPORTANTE al crear la API key en el exchange:
#   1. Habilita SOLO permisos de lectura y trading spot.
#   2. NO habilites retiradas. Nunca. El bot no las necesita.
#   3. Restringe por IP a la del servidor donde corre el bot.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Telegram ---------------------------------------------------------------
# 1. Habla con @BotFather → /newbot → copia el token.
# 2. Escribe algo a tu bot (si no, no puede responderte).
# 3. Abre https://api.telegram.org/bot<TOKEN>/getUpdates y copia chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Panel web --------------------------------------------------------------
# Obligatorio si el panel escucha fuera de localhost.
# Genera uno con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
WEB_AUTH_TOKEN=

# --- Overrides de configuración (opcional) ----------------------------------
# Cualquier campo del YAML se puede sobrescribir con el prefijo BOT__:
# BOT__RISK__RISK_PER_TRADE_PCT=0.25
# BOT__MODE=paper
