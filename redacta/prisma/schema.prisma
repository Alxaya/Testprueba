// ============================================================================
// Redacta — esquema de datos
//
// Convenciones:
//  - Todo el contenido de un cliente cuelga de `Organization` (multi-tenant).
//    Un usuario individual tambien tiene su Organization: evita migraciones
//    dolorosas el dia que se abran las cuentas de equipo.
//  - Los importes se guardan en centimos (Int) para evitar errores de coma
//    flotante.
//  - Los borrados son en cascada desde Organization: dar de baja a un cliente
//    es una sola operacion.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Rol global de la plataforma (distinto del rol dentro de una organizacion).
enum UserRole {
  USER
  ADMIN
}

/// Rol del usuario dentro de su organizacion.
enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

/// Planes comerciales. El precio y los limites viven en src/lib/plans.ts
/// para poder cambiarlos sin migrar la base de datos.
enum PlanId {
  FREE
  STARTER
  PRO
  BUSINESS
}

/// Refleja los estados de suscripcion de Stripe que nos interesan.
enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

/// Tipos de contenido que sabe generar el motor de IA.
enum ContentType {
  PRODUCT_DESCRIPTION
  BLOG_ARTICLE
  SEO_METADATA
  SOCIAL_SCRIPT
  AD_COPY
  EMAIL_CAMPAIGN
  FAQ
}

enum GenerationStatus {
  PENDING
  COMPLETED
  FAILED
}

enum EmailStatus {
  SENT
  FAILED
  SKIPPED
}

// ---------------------------------------------------------------------------
// Autenticacion (compatible con Auth.js v5 + @auth/prisma-adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// Hash bcrypt. Null cuando el usuario solo entra con OAuth.
  passwordHash  String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  accounts    Account[]
  sessions    Session[]
  memberships Membership[]
  generations Generation[]
  events      AnalyticsEvent[]

  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Organizaciones, suscripcion y uso
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Facturacion (espejo del estado en Stripe) ---
  plan                   PlanId             @default(FREE)
  subscriptionStatus     SubscriptionStatus @default(NONE)
  stripeCustomerId       String?            @unique
  stripeSubscriptionId   String?            @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  cancelAtPeriodEnd      Boolean            @default(false)

  members      Membership[]
  brandProfile BrandProfile?
  projects     Project[]
  generations  Generation[]
  usagePeriods UsagePeriod[]
  events       AnalyticsEvent[]
  emailLogs    EmailLog[]

  @@index([plan])
  @@index([subscriptionStatus])
}

model Membership {
  id             String     @id @default(cuid())
  userId         String
  organizationId String
  role           MemberRole @default(OWNER)
  createdAt      DateTime   @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

/// Contexto de marca que se inyecta en cada prompt: es lo que hace que el
/// contenido generado suene al cliente y no a IA generica.
model BrandProfile {
  id             String   @id @default(cuid())
  organizationId String   @unique
  brandName      String?
  sector         String?
  /// Descripcion del publico objetivo en lenguaje natural.
  audience       String?
  /// Tono de voz: cercano, tecnico, divertido, premium...
  toneOfVoice    String?
  /// Propuesta de valor / lo que diferencia al negocio.
  valueProps     String?
  /// Palabras clave prioritarias para SEO, separadas por coma.
  keywords       String?
  /// Cosas que el contenido NUNCA debe decir o hacer.
  avoid          String?
  language       String   @default("es")
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Project {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  archived       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  generations  Generation[]

  @@index([organizationId, archived])
}

/// Cada llamada al motor de IA. Es a la vez biblioteca de contenido para el
/// cliente y registro de consumo/coste para el negocio.
model Generation {
  id             String           @id @default(cuid())
  organizationId String
  userId         String?
  projectId      String?
  type           ContentType
  status         GenerationStatus @default(PENDING)
  title          String
  /// Parametros de entrada del formulario (JSON) para poder regenerar.
  input          Json
  /// Resultado en Markdown.
  output         String?          @db.Text
  errorMessage   String?
  model          String?
  inputTokens    Int              @default(0)
  outputTokens   Int              @default(0)
  /// Coste estimado en centimos de euro, para calcular margen por cliente.
  costCents      Int              @default(0)
  durationMs     Int              @default(0)
  favorite       Boolean          @default(false)
  createdAt      DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, type])
  @@index([status])
}

/// Contador de consumo por periodo de facturacion. Se agrega aqui en vez de
/// contar filas de Generation en cada request: mantiene el dashboard rapido
/// aunque el historico crezca.
model UsagePeriod {
  id             String   @id @default(cuid())
  organizationId String
  periodStart    DateTime
  periodEnd      DateTime
  generations    Int      @default(0)
  words          Int      @default(0)
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  costCents      Int      @default(0)
  /// Marca si ya se aviso al cliente de que llega al limite (evita spam).
  warnedAt       DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, periodStart])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Contenido publico (blog SEO)
// ---------------------------------------------------------------------------

model BlogPost {
  id             String    @id @default(cuid())
  slug           String    @unique
  title          String
  excerpt        String
  contentMd      String    @db.Text
  tags           String[]  @default([])
  seoTitle       String?
  seoDescription String?
  coverEmoji     String    @default("📝")
  published      Boolean   @default(false)
  publishedAt    DateTime?
  /// true cuando lo ha escrito el cron de contenido automatico.
  generatedByAi  Boolean   @default(false)
  readingMinutes Int       @default(4)
  views          Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([published, publishedAt])
}

// ---------------------------------------------------------------------------
// Analitica propia (sin cookies de terceros)
// ---------------------------------------------------------------------------

model AnalyticsEvent {
  id             String   @id @default(cuid())
  /// Nombre del evento: pageview, signup, generation_created, checkout_started...
  name           String
  organizationId String?
  userId         String?
  /// Identificador anonimo por dispositivo, sin datos personales.
  anonymousId    String?
  path           String?
  referrer       String?
  utmSource      String?
  utmMedium      String?
  utmCampaign    String?
  country        String?
  device         String?
  props          Json?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([createdAt])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Operativa: emails, webhooks, flags, auditoria
// ---------------------------------------------------------------------------

model EmailLog {
  id             String      @id @default(cuid())
  organizationId String?
  to             String
  template       String
  subject        String
  status         EmailStatus @default(SENT)
  error          String?
  createdAt      DateTime    @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([template, createdAt])
  @@index([to])
}

/// Garantiza que un webhook de Stripe se procesa una sola vez aunque Stripe
/// lo reintente.
model ProcessedWebhook {
  id            String   @id @default(cuid())
  stripeEventId String   @unique
  type          String
  processedAt   DateTime @default(now())
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorMail String?
  action    String
  target    String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
