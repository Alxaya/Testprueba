##############################################################################
# Redacta — variables de entorno
#
# Copia este fichero a `.env` y rellena los valores.
#   cp .env.example .env
#
# Las marcadas como OBLIGATORIA impiden arrancar la app si faltan.
# Las OPCIONALES degradan funcionalidad de forma controlada (ver src/lib/env.ts).
##############################################################################

# --- Aplicacion ----------------------------------------------------------
# OBLIGATORIA. URL publica completa, sin barra final.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Base de datos -------------------------------------------------------
# OBLIGATORIA. Cadena de conexion PostgreSQL.
# Con `docker compose up -d` el valor por defecto ya funciona.
DATABASE_URL="postgresql://redacta:redacta@localhost:5432/redacta?schema=public"

# --- Autenticacion (Auth.js v5) -----------------------------------------
# OBLIGATORIA. Genera una con: openssl rand -base64 32
AUTH_SECRET=""
# OBLIGATORIA en produccion detras de proxy (Vercel la pone sola).
AUTH_URL="http://localhost:3000"
# OPCIONALES. Si estan vacias, el boton de "Entrar con Google" no se muestra.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- IA (Anthropic) ------------------------------------------------------
# OBLIGATORIA para generar contenido. Sin ella el generador devuelve un
# error controlado en vez de romper la app.
ANTHROPIC_API_KEY=""
# OPCIONAL. Modelo por defecto. No lo cambies salvo motivo concreto.
ANTHROPIC_MODEL="claude-opus-5"

# --- Pagos (Stripe) ------------------------------------------------------
# OPCIONALES en desarrollo: sin ellas todas las cuentas quedan en plan FREE.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# IDs de precio (price_...) creados en el panel de Stripe. Ver docs/05-stripe.md
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_BUSINESS_MONTHLY=""

# --- Email transaccional (Resend) ---------------------------------------
# OPCIONALES. Sin ellas los emails se escriben en consola en vez de enviarse.
RESEND_API_KEY=""
EMAIL_FROM="Redacta <hola@redacta.example>"

# --- Automatizaciones ----------------------------------------------------
# OBLIGATORIA en produccion. Protege los endpoints /api/cron/*.
# Genera una con: openssl rand -hex 32
CRON_SECRET=""

# --- Administracion ------------------------------------------------------
# OPCIONAL. Emails separados por coma que reciben rol ADMIN al registrarse.
ADMIN_EMAILS=""
