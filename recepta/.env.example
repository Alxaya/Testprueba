# Copia este fichero a .env y rellena los valores.
# Genera los secretos con:  openssl rand -base64 32

NODE_ENV=development
LOG_LEVEL=debug

API_PORT=3001
API_HOST=0.0.0.0
PUBLIC_API_URL=http://localhost:3001

# Los puertos no son los estándar para no chocar con un Postgres/Redis
# que ya tengas instalado en la máquina.
DATABASE_URL=postgres://recepta:recepta@localhost:5433/recepta
REDIS_URL=redis://localhost:6380

ENCRYPTION_KEY=cambia-esto-por-32-bytes-en-base64-aaaa
SESSION_SECRET=cambia-esto-por-32-bytes-en-base64-bbbb

# 'simulator' permite desarrollar y demostrar el producto entero sin esperar
# a la aprobación de Meta como Tech Provider. Cambiar a 'meta' cuando llegue.
CHANNEL_DRIVER=simulator
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

ANTHROPIC_API_KEY=
AI_DAILY_BUDGET_CENTS=500

DEFAULT_TIMEZONE=Europe/Madrid
