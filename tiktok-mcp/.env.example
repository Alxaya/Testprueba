# Credenciales de tu app en https://developers.tiktok.com (Manage apps)
TIKTOK_CLIENT_KEY=tu_client_key
TIKTOK_CLIENT_SECRET=tu_client_secret

# Scopes solicitados en el OAuth (deben estar añadidos a tu app en el portal).
# Para publicar videos añade: ,video.publish
TIKTOK_SCOPES=user.info.basic,user.info.stats,video.list

# URL pública del servidor (la que te da Railway), SIN barra final.
# El redirect_uri que debes registrar en TikTok es: ${BASE_URL}/auth/callback
BASE_URL=https://tu-app.up.railway.app

# Opcional pero MUY recomendado: secreto en la ruta del endpoint MCP.
# Con esto el endpoint pasa de /mcp a /<secreto>/mcp
MCP_PATH_SECRET=

# Opcional: dónde guardar los tokens (móntalo en un volumen de Railway
# para que la sesión sobreviva a los redeploys)
TOKEN_STORE_PATH=./data/tokens.json

# Railway define PORT automáticamente; en local puedes fijarlo
# PORT=3000
