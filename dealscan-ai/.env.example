# ---------------------------------------------------------------------------
# DealScan AI — configuración
#
# Copia este fichero a `.env` y rellena los valores.
# Ninguna credencial tiene valor por defecto falso: si falta una, la función que
# la necesita responde con un error explicando qué añadir. Nada se simula.
# ---------------------------------------------------------------------------

# --- Obligatorias ----------------------------------------------------------

# PostgreSQL. Con docker-compose ya viene resuelto (servicio `db`).
DATABASE_URL="postgresql://dealscan:dealscan@localhost:5432/dealscan?schema=public"

# Secreto para firmar las sesiones. Genera uno propio:
#   openssl rand -base64 48
AUTH_SECRET=""

# URL pública de la aplicación. Se usa en los enlaces compartidos y en las
# redirecciones de Stripe, así que en producción debe ser el dominio real.
APP_URL="http://localhost:3000"


# --- Inteligencia artificial (opcional pero recomendada) -------------------
#
# Sin esta clave la aplicación FUNCIONA: identifica el producto con el
# analizador determinista por reglas y el informe lo indica. Lo que no podrá
# hacer es leer capturas de pantalla, que requiere el modelo de visión.
#
# Se obtiene en https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=""
# Modelo a usar. `claude-sonnet-5` da el mejor equilibrio coste/latencia para
# esta tarea; `claude-opus-5` extrae algo mejor en anuncios muy confusos.
ANTHROPIC_MODEL="claude-sonnet-5"


# --- Stripe (opcional: necesaria solo para cobrar suscripciones) -----------
#
# Todas se obtienen en https://dashboard.stripe.com
# Si falta alguna, las rutas de pago devuelven 503 indicando cuál falta.

# Clave secreta: Developers → API keys (sk_test_… en pruebas)
STRIPE_SECRET_KEY=""

# Secreto del webhook: Developers → Webhooks → añade el endpoint
#   https://TU-DOMINIO/api/stripe/webhook
# con los eventos: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted,
# invoice.payment_failed
# En local: stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""

# ID del precio recurrente del plan Premium: Products → tu producto → Pricing
STRIPE_PRICE_ID_PREMIUM_MONTHLY=""

# Clave pública (se expone al navegador; no es secreta)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""


# --- Límites de uso (opcional) ---------------------------------------------

# Análisis diarios del plan gratuito.
FREE_DAILY_LIMIT="5"

# Análisis diarios para visitantes sin cuenta, por IP. Pon 0 para exigir
# registro desde el primer análisis.
ANONYMOUS_DAILY_LIMIT="3"
